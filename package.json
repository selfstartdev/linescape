{
  "name": "linescape",
  "version": "0.2.1",
  "description": "Designed background lines for the web: bands, sweeps, wiggles, loops and swirls.",
  "license": "MIT",
  "author": "SelfStartDev",
  "homepage": "https://linescape.selfstartdev.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selfstartdev/linescape.git"
  },
  "bugs": {
    "url": "https://github.com/selfstartdev/linescape/issues"
  },
  "keywords": [
    "svg",
    "line",
    "background",
    "stroke",
    "decoration",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
