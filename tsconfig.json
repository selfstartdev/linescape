{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    // src/react imports the core as "linescape", like a user would; tsup leaves that import external.
    "paths": { "linescape": ["./src/index.ts"] }
  },
  "include": ["src", "test", "tsup.config.ts", "vitest.config.ts"]
}
